{
  "name": "task-wheel-panel",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "lint": "eslint .",
    "architecture": "eslint . && jscpd --config .jscpd.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@lit/context": "1.1.6",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.2",
    "jscpd": "5.4.2",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
